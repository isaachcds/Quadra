<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Quadra.App.Pages.EpubReaderPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#FAF8F3"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Cabeçalho -->
        <Grid
            Grid.Row="0"
            IsVisible="{Binding ControlesVisiveis}"
            Padding="12"
            ColumnDefinitions="Auto,*,Auto"
            BackgroundColor="#F4F0E8"
            ZIndex="2">

            <Button
                Grid.Column="0"
                Text="‹"
                WidthRequest="42"
                HeightRequest="42"
                Padding="0"
                CornerRadius="21"
                FontSize="30"
                BackgroundColor="#16000000"
                TextColor="#202020"
                Command="{Binding VoltarCommand}" />

            <VerticalStackLayout
                Grid.Column="1"
                Margin="12,0"
                VerticalOptions="Center"
                Spacing="2">

                <Label
                    Text="{Binding Item.Title}"
                    HorizontalTextAlignment="Center"
                    MaxLines="1"
                    LineBreakMode="TailTruncation"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#202020" />

                <Label
                    Text="{Binding TituloCapitulo}"
                    HorizontalTextAlignment="Center"
                    MaxLines="1"
                    LineBreakMode="TailTruncation"
                    FontSize="11"
                    TextColor="#707070" />

            </VerticalStackLayout>

            <Label
                Grid.Column="2"
                Text="{Binding TextoCapitulo}"
                VerticalOptions="Center"
                FontSize="12"
                TextColor="#505050" />

        </Grid>

        <!-- Conteúdo do EPUB -->
        <Grid Grid.Row="1">

            <WebView
                x:Name="EpubWebView"
                Source="{Binding ConteudoCapitulo}"
                Navigating="OnWebViewNavigating"
                BackgroundColor="#FAF8F3" />

            <!-- Área central para alternar os controles -->
            <Button
                HorizontalOptions="Center"
                VerticalOptions="Start"
                Margin="0,10,0,0"
                WidthRequest="100"
                HeightRequest="38"
                Opacity="0.01"
                BackgroundColor="Transparent"
                Command="{Binding AlternarControlesCommand}" />

        </Grid>

        <!-- Rodapé -->
        <Grid
            Grid.Row="2"
            IsVisible="{Binding ControlesVisiveis}"
            Padding="12,10"
            ColumnDefinitions="*,Auto,*"
            BackgroundColor="#F4F0E8"
            ZIndex="2">

            <Button
                Grid.Column="0"
                Text="Anterior"
                HorizontalOptions="Start"
                Padding="18,10"
                CornerRadius="20"
                BackgroundColor="#16000000"
                TextColor="#202020"
                Command="{Binding VoltarCapituloCommand}" />

            <Label
                Grid.Column="1"
                Text="{Binding TextoCapitulo}"
                Margin="14,0"
                VerticalOptions="Center"
                FontSize="12"
                TextColor="#505050" />

            <Button
                Grid.Column="2"
                Text="Próximo"
                HorizontalOptions="End"
                Padding="18,10"
                CornerRadius="20"
                BackgroundColor="#6C4DF6"
                TextColor="White"
                Command="{Binding AvancarCapituloCommand}" />

        </Grid>

        <!-- Carregamento -->
        <Grid
            Grid.RowSpan="3"
            IsVisible="{Binding EstaCarregando}"
            BackgroundColor="#FAF8F3"
            ZIndex="10">

            <VerticalStackLayout
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="14">

                <ActivityIndicator
                    IsRunning="{Binding EstaCarregando}"
                    WidthRequest="42"
                    HeightRequest="42"
                    Color="#6C4DF6" />

                <Label
                    Text="Preparando livro..."
                    FontSize="14"
                    TextColor="#202020" />

            </VerticalStackLayout>

        </Grid>

    </Grid>

</ContentPage>
