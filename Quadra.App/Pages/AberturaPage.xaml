<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Quadra.App.Pages.AberturaPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource ColorBackgroundLight}, Dark={StaticResource ColorBackgroundDark}}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
    <Grid Padding="32">
        <Image x:Name="OpeningLogo"
               Source="{AppThemeBinding Light=logo.svg, Dark=logo_dark.svg}"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               WidthRequest="320"
               HeightRequest="214"
               Aspect="AspectFit"
               Opacity="0"
               Scale="0.92" />
    </Grid>
</ContentPage>
