<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Quadra.App.Pages.AberturaPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource ColorBackgroundLight}, Dark={StaticResource ColorBackgroundDark}}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
    <Grid>
        <Border HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="192"
                HeightRequest="264"
                Padding="28"
                BackgroundColor="{StaticResource ColorSurfaceHighLight}"
                Stroke="{StaticResource ColorOutlineMutedLight}"
                StrokeShape="RoundRectangle 24">
            <Image x:Name="OpeningLogo"
                   Source="quadra_opening_logo.svg"
                   Aspect="AspectFit"
                   Opacity="0"
                   Scale="0.92" />
        </Border>
    </Grid>
</ContentPage>
