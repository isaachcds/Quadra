<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Quadra.App.Pages.DetalhesObraPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Quadra.App.Controls"
    xmlns:viewModels="clr-namespace:Quadra.App.ViewModels"
    x:DataType="viewModels:DetalhesObraViewModel"
    AutomationId="BookDetailsPage"
    BackgroundColor="{AppThemeBinding Light={StaticResource ColorBackgroundLight}, Dark={StaticResource ColorBackgroundDark}}"
    SafeAreaEdges="Container"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <Grid
            Grid.Row="0"
            Padding="20,10"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="{StaticResource SpacingSm}"
            BackgroundColor="{AppThemeBinding Light={StaticResource ColorSurfaceLowLight}, Dark={StaticResource ColorSurfaceLowDark}}">
            <ImageButton
                AutomationId="BookDetailsBackButton"
                Source="icon_back.svg"
                WidthRequest="{StaticResource TouchTargetMinimum}"
                HeightRequest="{StaticResource TouchTargetMinimum}"
                Padding="12"
                BackgroundColor="Transparent"
                Clicked="OnBackClicked"
                SemanticProperties.Description="Voltar para a Biblioteca" />
            <Label
                Grid.Column="1"
                Text="{StaticResource StringDetails}"
                Style="{StaticResource HeadlineMedium}"
                TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}"
                VerticalOptions="Center" />
            <ImageButton
                Grid.Column="2"
                AutomationId="BookDetailsHeaderDeleteButton"
                Source="icon_delete.svg"
                WidthRequest="{StaticResource TouchTargetMinimum}"
                HeightRequest="{StaticResource TouchTargetMinimum}"
                Padding="12"
                BackgroundColor="Transparent"
                IsVisible="{Binding PodeExcluir}"
                IsEnabled="{Binding PodeExcluir}"
                Command="{Binding ExcluirCommand}"
                SemanticProperties.Description="Excluir esta obra da biblioteca" />
            <BoxView
                Grid.ColumnSpan="3"
                HeightRequest="1"
                Margin="-20,0"
                Color="{AppThemeBinding Light={StaticResource ColorOutlineMutedLight}, Dark={StaticResource ColorOutlineMutedDark}}"
                VerticalOptions="End" />
        </Grid>

        <ScrollView Grid.Row="1" IsVisible="{Binding ConteudoValido}">
            <VerticalStackLayout
                Padding="20,24,20,40"
                Spacing="{StaticResource SpacingLg}">

                <controls:CapaObraView
                    AutomationId="BookDetailsCover"
                    WidthRequest="210"
                    HeightRequest="300"
                    HorizontalOptions="Center"
                    CaminhoCapa="{Binding Item.CoverPath}"
                    PossuiCapa="{Binding PossuiCapa}"
                    Formato="{Binding TextoFormato}"
                    DescricaoCapa="{Binding DescricaoCapa}" />

                <VerticalStackLayout Spacing="{StaticResource SpacingSm}">
                    <Label
                        AutomationId="BookDetailsTitle"
                        Text="{Binding Item.Title}"
                        Style="{StaticResource HeadlineMobile}"
                        TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}"
                        HorizontalTextAlignment="Center"
                        MaxLines="2"
                        LineBreakMode="TailTruncation"
                        SemanticProperties.HeadingLevel="Level1" />
                    <Label
                        Text="{Binding Item.OriginalFileName}"
                        Style="{StaticResource SecondaryTextStyle}"
                        HorizontalTextAlignment="Center"
                        MaxLines="2"
                        LineBreakMode="MiddleTruncation" />
                </VerticalStackLayout>

                <Border
                    AutomationId="BookDetailsProgress"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="{StaticResource SpacingMd}"
                    SemanticProperties.Description="{Binding DescricaoProgresso}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{StaticResource RadiusLarge}" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="{StaticResource StringCurrentReading}"
                                Style="{StaticResource BodyTextStyle}"
                                FontFamily="OpenSansSemibold" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding TextoPercentualProgresso}"
                                Style="{StaticResource LabelSmall}"
                                TextColor="{AppThemeBinding Light={StaticResource ColorAccentPrimaryLight}, Dark={StaticResource ColorAccentPrimaryDark}}" />
                        </Grid>
                        <ProgressBar
                            Progress="{Binding PercentualProgresso}"
                            Style="{StaticResource ProgressBarStyle}"
                            HeightRequest="6" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="{Binding TextoEstadoProgresso}"
                                Style="{StaticResource SecondaryTextStyle}" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding TextoPosicaoProgresso}"
                                Style="{StaticResource SecondaryTextStyle}"
                                HorizontalTextAlignment="End" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="{StaticResource SpacingSm}">
                    <Button
                        AutomationId="BookDetailsPrimaryAction"
                        Text="{Binding TextoBotaoLeitura}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="{Binding PodeLer}"
                        Command="{Binding IniciarLeituraCommand}"
                        SemanticProperties.Description="{Binding DescricaoBotaoLeitura}" />
                    <HorizontalStackLayout
                        IsVisible="{Binding EstaPreparandoLeitura}"
                        Spacing="{StaticResource SpacingSm}"
                        HorizontalOptions="Center">
                        <ActivityIndicator
                            IsRunning="{Binding EstaPreparandoLeitura}"
                            Color="{AppThemeBinding Light={StaticResource ColorAccentPrimaryLight}, Dark={StaticResource ColorAccentPrimaryDark}}" />
                        <Label
                            Text="{Binding TextoPreparacao}"
                            Style="{StaticResource SecondaryTextStyle}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout
                    AutomationId="BookDetailsFileInfo"
                    Spacing="{StaticResource SpacingSm}"
                    SemanticProperties.Description="Informações reais do arquivo armazenado">
                    <HorizontalStackLayout Spacing="{StaticResource SpacingSm}">
                        <Image
                            Source="icon_info.svg"
                            WidthRequest="24"
                            HeightRequest="24"
                            SemanticProperties.Description="Informações do arquivo" />
                        <Label
                            Text="{StaticResource StringAboutFile}"
                            Style="{StaticResource SectionTitleStyle}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource SpacingMd}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource RadiusLarge}" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="{StaticResource SpacingMd}">
                            <Grid ColumnDefinitions="120,*" ColumnSpacing="{StaticResource SpacingSm}">
                                <Label Text="{StaticResource StringOriginalName}" Style="{StaticResource SecondaryTextStyle}" />
                                <Label Grid.Column="1" Text="{Binding Item.OriginalFileName}" Style="{StaticResource BodyTextStyle}" HorizontalTextAlignment="End" MaxLines="2" LineBreakMode="MiddleTruncation" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource ColorOutlineMutedLight}, Dark={StaticResource ColorOutlineMutedDark}}" />
                            <Grid ColumnDefinitions="120,*" ColumnSpacing="{StaticResource SpacingSm}">
                                <Label Text="{StaticResource StringFormat}" Style="{StaticResource SecondaryTextStyle}" />
                                <Label Grid.Column="1" Text="{Binding TextoFormato}" Style="{StaticResource BodyTextStyle}" HorizontalTextAlignment="End" />
                            </Grid>
                            <Grid ColumnDefinitions="120,*" ColumnSpacing="{StaticResource SpacingSm}">
                                <Label Text="{StaticResource StringImportedAt}" Style="{StaticResource SecondaryTextStyle}" />
                                <Label Grid.Column="1" Text="{Binding TextoDataImportacao}" Style="{StaticResource BodyTextStyle}" HorizontalTextAlignment="End" />
                            </Grid>
                            <Grid ColumnDefinitions="120,*" ColumnSpacing="{StaticResource SpacingSm}">
                                <Label Text="{StaticResource StringTotalContent}" Style="{StaticResource SecondaryTextStyle}" />
                                <Label Grid.Column="1" Text="{Binding TextoTotal}" Style="{StaticResource BodyTextStyle}" HorizontalTextAlignment="End" />
                            </Grid>
                            <Grid ColumnDefinitions="120,*" ColumnSpacing="{StaticResource SpacingSm}">
                                <Label Text="{StaticResource StringLastRead}" Style="{StaticResource SecondaryTextStyle}" />
                                <Label Grid.Column="1" Text="{Binding TextoUltimaLeitura}" Style="{StaticResource BodyTextStyle}" HorizontalTextAlignment="End" />
                            </Grid>
                            <Grid
                                ColumnDefinitions="120,*"
                                ColumnSpacing="{StaticResource SpacingSm}"
                                IsVisible="{Binding PossuiTamanhoArquivo}">
                                <Label Text="{StaticResource StringFileSize}" Style="{StaticResource SecondaryTextStyle}" />
                                <Label Grid.Column="1" Text="{Binding TextoTamanhoArquivo}" Style="{StaticResource BodyTextStyle}" HorizontalTextAlignment="End" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Button
                    AutomationId="BookDetailsDeleteButton"
                    Text="{StaticResource StringDeleteFromLibrary}"
                    Style="{StaticResource DangerButtonStyle}"
                    IsEnabled="{Binding PodeExcluir}"
                    Command="{Binding ExcluirCommand}"
                    SemanticProperties.Description="Excluir a cópia interna desta obra e seus dados de leitura" />
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout
            Grid.Row="1"
            IsVisible="{Binding ArquivoAusente}"
            Padding="32"
            Spacing="{StaticResource SpacingMd}"
            HorizontalOptions="Center"
            VerticalOptions="Center">
            <Image Source="icon_book_placeholder.svg" WidthRequest="72" HeightRequest="72" Opacity="0.72" />
            <Label
                Text="{StaticResource StringMissingInternalFile}"
                Style="{StaticResource SectionTitleStyle}"
                HorizontalTextAlignment="Center" />
            <Label
                Text="{StaticResource StringMissingInternalFileHelp}"
                Style="{StaticResource SecondaryTextStyle}"
                HorizontalTextAlignment="Center" />
            <Button
                Text="{StaticResource StringBackToLibrary}"
                Style="{StaticResource SecondaryButtonStyle}"
                Clicked="OnBackClicked" />
            <Button
                AutomationId="BookDetailsDeleteMissingButton"
                Text="{StaticResource StringDeleteFromLibrary}"
                Style="{StaticResource DangerButtonStyle}"
                IsEnabled="{Binding PodeExcluir}"
                Command="{Binding ExcluirCommand}"
                SemanticProperties.Description="Excluir o registro desta obra ausente" />
        </VerticalStackLayout>

        <VerticalStackLayout
            Grid.Row="1"
            IsVisible="{Binding TemErroCarregamento}"
            Padding="32"
            Spacing="{StaticResource SpacingMd}"
            HorizontalOptions="Center"
            VerticalOptions="Center">
            <Label Text="{Binding MensagemErro}" Style="{StaticResource SectionTitleStyle}" HorizontalTextAlignment="Center" />
            <Button
                Text="{StaticResource StringTryAgain}"
                Style="{StaticResource SecondaryButtonStyle}"
                Command="{Binding AtualizarDetalhesCommand}" />
            <Button
                Text="{StaticResource StringBackToLibrary}"
                Style="{StaticResource DangerButtonStyle}"
                Clicked="OnBackClicked" />
        </VerticalStackLayout>

        <VerticalStackLayout
            Grid.Row="1"
            IsVisible="{Binding EstaCarregando}"
            Spacing="{StaticResource SpacingSm}"
            HorizontalOptions="Center"
            VerticalOptions="Center">
            <ActivityIndicator IsRunning="{Binding EstaCarregando}" />
            <Label Text="Carregando detalhes…" Style="{StaticResource SecondaryTextStyle}" />
        </VerticalStackLayout>

        <Grid
            Grid.RowSpan="2"
            IsVisible="{Binding EstaExcluindo}"
            BackgroundColor="{AppThemeBinding Light={StaticResource ColorSurfaceLowestLight}, Dark={StaticResource ColorSurfaceLowestDark}}"
            Opacity="0.96"
            InputTransparent="False">
            <Border
                Style="{StaticResource CardBorderStyle}"
                Padding="24"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{StaticResource RadiusLarge}" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="{StaticResource SpacingMd}" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding EstaExcluindo}" />
                    <Label Text="Excluindo obra…" Style="{StaticResource BodyTextStyle}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
