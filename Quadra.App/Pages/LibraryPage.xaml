<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Quadra.App.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Quadra.App.Controls"
    xmlns:services="clr-namespace:Quadra.App.Services"
    xmlns:viewModels="clr-namespace:Quadra.App.ViewModels"
    x:Name="PageRoot"
    x:DataType="viewModels:LibraryViewModel"
    AutomationId="LibraryPage"
    BackgroundColor="{AppThemeBinding Light={StaticResource ColorBackgroundLight}, Dark={StaticResource ColorBackgroundDark}}"
    SafeAreaEdges="Container"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="True">

    <Grid RowDefinitions="Auto,*">
        <Grid
            Padding="20,16,20,10"
            ColumnDefinitions="Auto,*,Auto,Auto"
            ColumnSpacing="{StaticResource SpacingSm}">
            <Image
                Source="quadra_mark.svg"
                WidthRequest="40"
                HeightRequest="40"
                SemanticProperties.Description="Símbolo do Quadra"
                VerticalOptions="Center" />
            <Label
                Grid.Column="1"
                Text="Biblioteca"
                Style="{StaticResource HeadlineMobile}"
                TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}"
                VerticalOptions="Center" />
            <ImageButton
                Grid.Column="2"
                Source="icon_search.svg"
                WidthRequest="48"
                HeightRequest="48"
                Padding="12"
                IsEnabled="False"
                BackgroundColor="Transparent"
                SemanticProperties.Description="Busca será adicionada em breve" />
            <ImageButton
                Grid.Column="3"
                Source="icon_filter.svg"
                WidthRequest="48"
                HeightRequest="48"
                Padding="12"
                BackgroundColor="Transparent"
                Command="{Binding MostrarFiltrosCommand}"
                SemanticProperties.Description="Mostrar ou ocultar filtros por formato" />
        </Grid>

        <Grid Grid.Row="1" Padding="20,0" RowDefinitions="Auto,Auto,*">
            <VerticalStackLayout
                IsVisible="{Binding PossuiContinuarLendo}"
                Spacing="{StaticResource SpacingSm}"
                Margin="0,8,0,16">
                <Label Text="Continuar lendo" Style="{StaticResource SectionTitleStyle}" />
                <controls:ContinueReadingCard
                    Item="{Binding ContinuarLendo}"
                    OpenCommand="{Binding AbrirDetalhesCommand}" />
            </VerticalStackLayout>

            <ScrollView
                Grid.Row="1"
                Orientation="Horizontal"
                HorizontalScrollBarVisibility="Never"
                IsVisible="{Binding FiltrosVisiveis}"
                Margin="0,0,0,16">
                <HorizontalStackLayout Spacing="{StaticResource SpacingSm}">
                    <Button
                        AutomationId="FormatFilterAll"
                        Text="Todos"
                        Style="{StaticResource FilterChipStyle}"
                        Command="{Binding SelecionarFiltroCommand}"
                        CommandParameter="{x:Static services:LibraryFormatFilter.All}"
                        SemanticProperties.Description="{Binding DescricaoFiltroTodos}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding FiltroTodosSelecionado}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorAccentPrimaryMutedLight}, Dark={StaticResource ColorAccentPrimaryMutedDark}}" />
                                <Setter Property="TextColor" Value="{StaticResource ColorAccentOnPrimaryDark}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button
                        AutomationId="FormatFilterEpub"
                        Text="EPUB"
                        Style="{StaticResource FilterChipStyle}"
                        Command="{Binding SelecionarFiltroCommand}"
                        CommandParameter="{x:Static services:LibraryFormatFilter.Epub}"
                        SemanticProperties.Description="{Binding DescricaoFiltroEpub}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding FiltroEpubSelecionado}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorAccentPrimaryMutedLight}, Dark={StaticResource ColorAccentPrimaryMutedDark}}" />
                                <Setter Property="TextColor" Value="{StaticResource ColorAccentOnPrimaryDark}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button
                        AutomationId="FormatFilterPdf"
                        Text="PDF"
                        Style="{StaticResource FilterChipStyle}"
                        Command="{Binding SelecionarFiltroCommand}"
                        CommandParameter="{x:Static services:LibraryFormatFilter.Pdf}"
                        SemanticProperties.Description="{Binding DescricaoFiltroPdf}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding FiltroPdfSelecionado}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorAccentPrimaryMutedLight}, Dark={StaticResource ColorAccentPrimaryMutedDark}}" />
                                <Setter Property="TextColor" Value="{StaticResource ColorAccentOnPrimaryDark}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button
                        AutomationId="FormatFilterComics"
                        Text="CBR/CBZ"
                        Style="{StaticResource FilterChipStyle}"
                        Command="{Binding SelecionarFiltroCommand}"
                        CommandParameter="{x:Static services:LibraryFormatFilter.Comics}"
                        SemanticProperties.Description="{Binding DescricaoFiltroComics}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding FiltroComicsSelecionado}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorAccentPrimaryMutedLight}, Dark={StaticResource ColorAccentPrimaryMutedDark}}" />
                                <Setter Property="TextColor" Value="{StaticResource ColorAccentOnPrimaryDark}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </HorizontalStackLayout>
            </ScrollView>

            <CollectionView
                Grid.Row="2"
                AutomationId="LibraryGrid"
                IsVisible="{Binding BibliotecaPreenchida}"
                ItemsSource="{Binding ItensFiltrados}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        Orientation="Vertical"
                        Span="2"
                        HorizontalItemSpacing="16"
                        VerticalItemSpacing="24" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:LibraryBookViewData">
                        <controls:LibraryBookCard
                            Item="{Binding .}"
                            OpenCommand="{Binding BindingContext.AbrirDetalhesCommand, Source={x:Reference PageRoot}}"
                            DeleteCommand="{Binding BindingContext.ExcluirItemCommand, Source={x:Reference PageRoot}}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <BoxView HeightRequest="96" BackgroundColor="Transparent" />
                </CollectionView.Footer>
            </CollectionView>

            <VerticalStackLayout
                Grid.Row="2"
                IsVisible="{Binding FiltroSemResultados}"
                Spacing="{StaticResource SpacingMd}"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Label
                    Text="Nenhuma obra neste formato"
                    Style="{StaticResource BodyTextStyle}"
                    FontFamily="OpenSansSemibold"
                    HorizontalTextAlignment="Center" />
                <Button
                    Text="Mostrar todos"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding VoltarParaTodosCommand}" />
            </VerticalStackLayout>

            <controls:EmptyLibraryView
                Grid.RowSpan="3"
                IsVisible="{Binding BibliotecaVazia}"
                ImportCommand="{Binding ImportarArquivoCommand}"
                IsImportEnabled="{Binding PodeImportar}" />

            <VerticalStackLayout
                Grid.RowSpan="3"
                IsVisible="{Binding TemErro}"
                Spacing="{StaticResource SpacingMd}"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Label Text="{Binding MensagemErro}" Style="{StaticResource BodyTextStyle}" />
                <Button
                    Text="Tentar novamente"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding CarregarBibliotecaCommand}" />
            </VerticalStackLayout>

            <VerticalStackLayout
                Grid.RowSpan="3"
                IsVisible="{Binding EstaCarregandoBiblioteca}"
                Spacing="{StaticResource SpacingSm}"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <ActivityIndicator IsRunning="{Binding EstaCarregandoBiblioteca}" />
                <Label Text="Carregando biblioteca…" Style="{StaticResource SecondaryTextStyle}" />
            </VerticalStackLayout>

            <ImageButton
                Grid.RowSpan="3"
                AutomationId="ImportButton"
                Source="icon_import.svg"
                WidthRequest="64"
                HeightRequest="64"
                Padding="18"
                Margin="0,0,4,20"
                CornerRadius="32"
                BackgroundColor="{AppThemeBinding Light={StaticResource ColorAccentPrimaryLight}, Dark={StaticResource ColorAccentPrimaryDark}}"
                HorizontalOptions="End"
                VerticalOptions="End"
                IsVisible="{Binding PossuiItens}"
                IsEnabled="{Binding PodeImportar}"
                Command="{Binding ImportarArquivoCommand}"
                SemanticProperties.Description="Importar arquivo" />
        </Grid>

        <Grid
            Grid.RowSpan="2"
            IsVisible="{Binding EstaImportando}"
            BackgroundColor="{AppThemeBinding Light={StaticResource ColorSurfaceLowestLight}, Dark={StaticResource ColorSurfaceLowestDark}}"
            Opacity="0.96"
            InputTransparent="False">
            <Border
                Style="{StaticResource CardBorderStyle}"
                Padding="24"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{StaticResource RadiusLarge}" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="{StaticResource SpacingMd}" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding EstaImportando}" />
                    <Label Text="Importando arquivo…" Style="{StaticResource BodyTextStyle}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
