<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Quadra.App.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{AppThemeBinding Light=#F7F7F7, Dark=#121212}"
    Shell.NavBarIsVisible="False">

    <Grid
        Padding="24"
        RowDefinitions="Auto,*">

        <!-- Cabeçalho -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            Margin="0,12,0,24">

            <VerticalStackLayout
                Grid.Column="0"
                Spacing="2">

                <Label
                    Text="Quadra"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                <Label
                    Text="Sua biblioteca"
                    FontSize="15"
                    TextColor="{AppThemeBinding Light=#666666, Dark=#AFAFAF}" />

            </VerticalStackLayout>

            <Button
                Grid.Column="1"
                Text="+"
                WidthRequest="48"
                HeightRequest="48"
                CornerRadius="24"
                FontSize="26"
                Padding="0"
                VerticalOptions="Center"
                BackgroundColor="#6C4DF6"
                TextColor="White"
                Command="{Binding ImportarArquivoCommand}" />

        </Grid>

        <!-- Estado vazio -->
        <VerticalStackLayout
            Grid.Row="1"
            IsVisible="{Binding BibliotecaVazia}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            MaximumWidthRequest="320"
            Spacing="12">

            <Border
                WidthRequest="96"
                HeightRequest="96"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=#E9E5FF, Dark=#27213F}"
                HorizontalOptions="Center">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="48" />
                </Border.StrokeShape>

                <Label
                    Text="▤"
                    FontSize="42"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    TextColor="#6C4DF6" />

            </Border>

            <Label
                Text="Sua biblioteca está vazia"
                FontSize="20"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

            <Label
                Text="Adicione um arquivo CBR, CBZ ou PDF para começar sua leitura."
                FontSize="14"
                HorizontalTextAlignment="Center"
                TextColor="{AppThemeBinding Light=#666666, Dark=#AFAFAF}" />

            <Button
                Text="Adicionar arquivo"
                Margin="0,12,0,0"
                Padding="24,12"
                CornerRadius="14"
                BackgroundColor="#6C4DF6"
                TextColor="White"
                FontAttributes="Bold"
                Command="{Binding ImportarArquivoCommand}" />

            <ActivityIndicator
                IsRunning="{Binding EstaImportando}"
                IsVisible="{Binding EstaImportando}"
                Color="#6C4DF6"
                HorizontalOptions="Center" />

        </VerticalStackLayout>

        <!-- Biblioteca com itens -->
        <CollectionView
            Grid.Row="1"
            IsVisible="{Binding PossuiItens}"
            ItemsSource="{Binding Itens}"
            SelectionMode="None">

            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    Orientation="Vertical"
                    Span="2"
                    HorizontalItemSpacing="14"
                    VerticalItemSpacing="18" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="8">

                    <ActivityIndicator
                        IsRunning="{Binding EstaImportando}"
                        IsVisible="{Binding EstaImportando}"
                        Color="#6C4DF6" />

                    <Label
                        Text="Carregando biblioteca..."
                        IsVisible="{Binding EstaImportando}"
                        FontSize="13"
                        TextColor="{AppThemeBinding Light=#666666, Dark=#AFAFAF}" />

                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Grid
                        RowDefinitions="Auto,Auto,Auto"
                        RowSpacing="8">

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AbrirDetalhesCommand}"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <!-- Capa -->
                        <Border
                            Grid.Row="0"
                            HeightRequest="190"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light=#E9E5FF, Dark=#27213F}">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Grid>

                                <!-- Placeholder -->
                                <VerticalStackLayout
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    Spacing="8">

                                    <Label
                                        Text="▤"
                                        FontSize="42"
                                        HorizontalOptions="Center"
                                        TextColor="#6C4DF6" />

                                    <Label
                                        Text="{Binding Format}"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        HorizontalOptions="Center"
                                        TextColor="{AppThemeBinding Light=#555555, Dark=#C7C7C7}" />

                                </VerticalStackLayout>

                                <!-- Capa real -->
                                <Image
                                    Source="{Binding CoverPath}"
                                    Aspect="AspectFill"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill" />

                                <!-- Selo do formato -->
                                <Border
                                    Padding="8,4"
                                    Margin="8"
                                    StrokeThickness="0"
                                    BackgroundColor="#6C4DF6"
                                    HorizontalOptions="Start"
                                    VerticalOptions="End">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>

                                    <Label
                                        Text="{Binding Format}"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        TextColor="White" />

                                </Border>

                                <!-- Botão de exclusão -->
                                <Button
                                    Text="⋮"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    Padding="0"
                                    Margin="0,4,4,0"
                                    FontSize="20"
                                    CornerRadius="18"
                                    BackgroundColor="#66000000"
                                    TextColor="White"
                                    HorizontalOptions="End"
                                    VerticalOptions="Start"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ExcluirItemCommand}"
                                    CommandParameter="{Binding .}" />

                            </Grid>

                        </Border>

                        <!-- Título -->
                        <Label
                            Grid.Row="1"
                            Text="{Binding Title}"
                            FontSize="14"
                            FontAttributes="Bold"
                            MaxLines="2"
                            LineBreakMode="TailTruncation"
                            TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                        <!-- Data -->
                        <Label
                            Grid.Row="2"
                            Text="{Binding ImportedAt, StringFormat='Importado em {0:dd/MM/yyyy}'}"
                            FontSize="11"
                            TextColor="{AppThemeBinding Light=#777777, Dark=#999999}" />

                    </Grid>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- Sobreposição durante importação -->
        <Grid
            Grid.RowSpan="2"
            IsVisible="{Binding EstaImportando}"
            BackgroundColor="#66000000"
            InputTransparent="False">

            <Border
                Padding="24"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout
                    Spacing="12"
                    HorizontalOptions="Center">

                    <ActivityIndicator
                        IsRunning="{Binding EstaImportando}"
                        Color="#6C4DF6"
                        WidthRequest="36"
                        HeightRequest="36" />

                    <Label
                        Text="Importando arquivo..."
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                </VerticalStackLayout>

            </Border>

        </Grid>

    </Grid>

</ContentPage>