<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Quadra.App.Controls.CartaoContinuarLeitura"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Quadra.App.Controls"
    x:Name="Root"
    AutomationId="ContinueReadingCard">

    <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource SpacingMd}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="{StaticResource RadiusLarge}" />
        </Border.StrokeShape>
        <Border.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding AbrirCommand, Source={x:Reference Root}}"
                CommandParameter="{Binding Obra.Item, Source={x:Reference Root}}" />
        </Border.GestureRecognizers>

        <Grid ColumnDefinitions="84,*" ColumnSpacing="{StaticResource SpacingMd}">
            <controls:CapaObraView
                HeightRequest="118"
                CaminhoCapa="{Binding Obra.CaminhoCapa, Source={x:Reference Root}}"
                PossuiCapa="{Binding Obra.PossuiCapa, Source={x:Reference Root}}"
                Formato="{Binding Obra.Formato, Source={x:Reference Root}}"
                DescricaoCapa="{Binding Obra.DescricaoCapa, Source={x:Reference Root}}" />

            <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource SpacingSm}" VerticalOptions="Center">
                <Label
                    Text="{Binding Obra.Titulo, Source={x:Reference Root}}"
                    Style="{StaticResource BodyTextStyle}"
                    FontFamily="OpenSansSemibold"
                    MaxLines="2"
                    LineBreakMode="TailTruncation" />
                <Label
                    Text="{Binding Obra.TextoProgresso, Source={x:Reference Root}}"
                    Style="{StaticResource SecondaryTextStyle}" />
                <ProgressBar
                    Progress="{Binding Obra.ValorProgresso, Source={x:Reference Root}}"
                    Style="{StaticResource ProgressBarStyle}"
                    HeightRequest="5" />
                <Label
                    Text="Continuar leitura"
                    Style="{StaticResource LabelMedium}"
                    FontFamily="OpenSansSemibold"
                    TextColor="{AppThemeBinding Light={StaticResource ColorAccentPrimaryLight}, Dark={StaticResource ColorAccentPrimaryDark}}" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
