<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Quadra.App.Controls.CapaObraView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root"
    SemanticProperties.Description="{Binding DescricaoCapa, Source={x:Reference Root}}">

    <Border
        Style="{StaticResource CardBorderStyle}"
        BackgroundColor="{AppThemeBinding Light={StaticResource ColorSurfaceLowLight}, Dark={StaticResource ColorSurfaceLowDark}}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="{StaticResource RadiusMedium}" />
        </Border.StrokeShape>

        <Grid>
            <Image
                Source="icon_book_placeholder.svg"
                WidthRequest="56"
                HeightRequest="56"
                Opacity="0.72"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <Image
                Source="{Binding CaminhoCapa, Source={x:Reference Root}}"
                IsVisible="{Binding PossuiCapa, Source={x:Reference Root}}"
                Aspect="AspectFill"
                HorizontalOptions="Fill"
                VerticalOptions="Fill" />

            <Border
                Margin="{StaticResource SpacingSm}"
                Padding="8,4"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource ColorAccentPrimaryMutedLight}, Dark={StaticResource ColorAccentPrimaryMutedDark}}"
                HorizontalOptions="Start"
                VerticalOptions="End">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{StaticResource RadiusPill}" />
                </Border.StrokeShape>
                <Label
                    Text="{Binding Formato, Source={x:Reference Root}}"
                    Style="{StaticResource LabelSmall}"
                    TextColor="{AppThemeBinding Light={StaticResource ColorAccentOnPrimaryLight}, Dark={StaticResource ColorAccentOnPrimaryDark}}" />
            </Border>
        </Grid>
    </Border>
</ContentView>
