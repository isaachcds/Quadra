<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Quadra.App.Controls.LibraryBookCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Quadra.App.Controls"
    x:Name="Root">

    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource SpacingSm}">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding OpenCommand, Source={x:Reference Root}}"
                CommandParameter="{Binding Item.Item, Source={x:Reference Root}}" />
        </Grid.GestureRecognizers>

        <Grid HeightRequest="210">
            <controls:BookCoverView
                CoverPath="{Binding Item.CoverPath, Source={x:Reference Root}}"
                HasCover="{Binding Item.HasCover, Source={x:Reference Root}}"
                Format="{Binding Item.Format, Source={x:Reference Root}}"
                CoverDescription="{Binding Item.CoverDescription, Source={x:Reference Root}}" />

            <ImageButton
                Source="icon_more.svg"
                WidthRequest="48"
                HeightRequest="48"
                Padding="12"
                Margin="0,2,2,0"
                BackgroundColor="{AppThemeBinding Light={StaticResource ColorSurfaceHighestLight}, Dark={StaticResource ColorSurfaceHighestDark}}"
                CornerRadius="24"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Command="{Binding DeleteCommand, Source={x:Reference Root}}"
                CommandParameter="{Binding Item.Item, Source={x:Reference Root}}"
                SemanticProperties.Description="Remover obra da biblioteca" />
        </Grid>

        <Label
            Grid.Row="1"
            Text="{Binding Item.Title, Source={x:Reference Root}}"
            Style="{StaticResource BodyTextStyle}"
            FontFamily="OpenSansSemibold"
            MaxLines="2"
            LineBreakMode="TailTruncation" />

        <VerticalStackLayout Grid.Row="2" Spacing="{StaticResource SpacingXs}">
            <Label
                Text="{Binding Item.ProgressText, Source={x:Reference Root}}"
                Style="{StaticResource SecondaryTextStyle}" />
            <ProgressBar
                Progress="{Binding Item.ProgressValue, Source={x:Reference Root}}"
                IsVisible="{Binding Item.ShowsProgress, Source={x:Reference Root}}"
                Style="{StaticResource ProgressBarStyle}"
                HeightRequest="4" />
        </VerticalStackLayout>
    </Grid>
</ContentView>
